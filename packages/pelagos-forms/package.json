{
  "name": "@bluecateng/pelagos-forms",
  "version": "5.3.1",
  "description": "Form components",
  "license": "ISC",
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && babel -D -d dist --env-name production --root-mode upward src && npm run bundle-dts",
    "bundle-dts": "dts-bundle-generator -o dist/index.d.ts --no-banner --silent --disable-symlinks-following src/index.d.ts",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:bluecatengineering/pelagos-packages.git",
    "directory": "packages/pelagos-forms"
  },
  "keywords": [
    "react"
  ],
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    "types": "./dist/index.d.ts",
    "default": "./dist/index.js"
  },
  "dependencies": {
    "prop-types": "^15.8.1"
  },
  "peerDependencies": {
    "@bluecateng/auto-forms": ">= 1",
    "@bluecateng/pelagos": ">= 12.23"
  }
}
